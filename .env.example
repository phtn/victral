# Cohere credentials power the default agent, compactor, and their fallback.
COHERE_API_KEY=
META_API_KEY=
# MODEL_API_KEY is also accepted as the Meta credential.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Local MLX server (mlx-lm). No credential is required; set MLX_API_KEY only
# when a proxy in front of the server expects a bearer token.
MLX_BASE_URL=http://127.0.0.1:8080
MLX_API_KEY=
# Short names: north-mini, command-a, command-a-plus, mw1.0, mwfull, luna6, sol6.1, sonnet5.5, opus5.5, cf-llama1b, cf-glm47, optiq, llama3b.
VICTRAL_MODEL=north-mini
# Default compactor for the default agent; remove this line to follow VICTRAL_MODEL.
# llama3b summarizes locally through the MLX server above and needs no credential;
# it falls back to command-a-plus when that server is unreachable.
VICTRAL_COMPACTOR_MODEL=llama3b
# Set to off to keep messages in full instead of summarizing them (same as
# --no-compaction). The context then grows every turn; /compaction on resumes.
VICTRAL_COMPACTION=on
# Milliseconds before an unanswered compactor request is stopped (default 300000).
VICTRAL_COMPACTOR_TIMEOUT_MS=
# Enables automatic background summary evaluations and live Jev metrics.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional TIKR browser research; requires locally installed Google Chrome.
# TIKR warns automated access may close accounts; see docs/TIKR.md before use.
TIKR_UN=
TIKR_PW=
