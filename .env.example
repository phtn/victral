META_API_KEY=
# MODEL_API_KEY is also accepted as the Meta credential.
# Meta credentials enable muse-wonder-full fallback for agent and compactor failures.
OPENAI_API_KEY=
# Short names: mw1.0, mwfull, luna6, sol6.1.
VICTRAL_MODEL=mw1.0
# Optional; defaults to the selected agent model.
# VICTRAL_COMPACTOR_MODEL=mw1.0
# Enables automatic background summary evaluations and live Jev metrics.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional TIKR browser research; requires locally installed Google Chrome.
# TIKR warns automated access may close accounts; see docs/TIKR.md before use.
TIKR_UN=
TIKR_PW=
