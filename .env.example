# Cohere credentials power the default agent, compactor, and their fallback.
COHERE_API_KEY=
META_API_KEY=
# MODEL_API_KEY is also accepted as the Meta credential.
OPENAI_API_KEY=
# Short names: north-mini, command-a, command-a-plus, mw1.0, mwfull, luna6, sol6.1.
VICTRAL_MODEL=north-mini
# Default compactor for the default agent; remove this line to follow VICTRAL_MODEL.
VICTRAL_COMPACTOR_MODEL=command-a
# Enables automatic background summary evaluations and live Jev metrics.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional TIKR browser research; requires locally installed Google Chrome.
# TIKR warns automated access may close accounts; see docs/TIKR.md before use.
TIKR_UN=
TIKR_PW=
