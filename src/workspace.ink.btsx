module /** @jsxImportSource @octanejs/ink/intrinsics */
import { Box, Text, useApp, useInput, useStdout, useWindowSize } from '@octanejs/ink';
import { useEffect, useMemo, useRef, useState } from 'octane/universal/native';
import stringWidth from 'string-width';
import { COMMANDS } from './session-commands.js';
import { markdownLines, type MarkdownLine } from './markdown.js';
import { safeText, shortProject, wrapLines, type WorkspaceSession } from './tui-model.js';
import { formatJevStatus } from './jev-status.js';
import { shortModelName } from './models.js';
import { commandCompletion, completeCommand, completionStatus } from './command-completion.js';
import { copyMarkdown, type CopyResponse } from './clipboard.js';
module
  const VERSION = '0.2.0'
  const codexBlue = '#5aa9ff'
  const user = '#009393'
  const muted = '#8b949e'
  const bright = '#e6edf3'
  const composerBg = '#333333'
  const composerDim = '#9a9a9a'
  const statusModel = '#e5c07b'
  const statusDot = '#6b7280'
  const statusPath = '#98c379'
  const errorRed = '#ff7b72'
  interface DisplayLine { text?: string; spans?: MarkdownLine['spans']; color: string; copyId?: number }
props { session, copyResponse = copyMarkdown }: { session: WorkspaceSession; copyResponse?: CopyResponse }
setup
  const [state, setState] = useState(() => session.snapshot())
  useEffect(() => {
    const update = () => setState(session.snapshot())
    session.on('update', update)
    update()
    return () => { session.off('update', update) }
  }, [session])
  const { columns, rows } = useWindowSize(),
    { exit } = useApp(),
    { stdout } = useStdout()
  const [input, setInput] = useState(''),
    [cursor, setCursor] = useState(0),
    [scroll, setScroll] = useState<number | null>(null)
  const [panel, setPanel] = useState<'chat' | 'metrics' | 'commands'>('chat')
  const [selected, setSelected] = useState(0),
    [history, setHistory] = useState<string[]>([]),
    [historyIndex, setHistoryIndex] = useState(-1)
  const [tick, setTick] = useState(0)
  const [completionSelection, setCompletionSelection] = useState({ key: '', index: 0 })
  const completion = commandCompletion(input, cursor)
  const completionIndex = completionSelection.key === completion.key ? Math.min(completionSelection.index, Math.max(0, completion.suggestions.length - 1)) : 0
  const [copyFeedback, setCopyFeedback] = useState<{ id: number; text: string; label: string } | null>(null)
  const copyTimer = useRef<ReturnType<typeof setTimeout> | null>(null)
  const mounted = useRef(true)
  useEffect(() => {
    mounted.current = true
    return () => {
      mounted.current = false
      if (copyTimer.current) clearTimeout(copyTimer.current)
    }
  }, [])
  const markdownCache = useRef(new Map<number, { text: string; width: number; lines: DisplayLine[] }>())
  const width = Math.max(10, columns - 2)
  const composerHeight = 3,
    headerHeight = 2,
    statusHeight = 1
  const bodyHeight = Math.max(1, rows - headerHeight - composerHeight - statusHeight - (state.active ? 1 : 0))
  useEffect(() => {
    if (!stdout.isTTY) return
    stdout.write('\x1b[?1000h\x1b[?1006h')
    return () => { stdout.write('\x1b[?1006l\x1b[?1000l') }
  }, [stdout])
  useEffect(() => {
    const closed = () => exit()
    session.on('closed', closed)
    return () => {
      session.off('closed', closed)
    }
  }, [session, exit])
  useEffect(() => {
    if (!state.active) return
    const timer = setInterval(() => setTick((t) => t + 1), 160)
    return () => clearInterval(timer)
  }, [state.active])
  const project = shortProject(safeText(session.options.project))
  const lines = useMemo<DisplayLine[]>(() => {
    if (panel === 'metrics') return markdownLines(session.metrics.detailed(), width).map(line => ({ ...line, color: muted }))
    if (!state.entries.length) return []
    const ids = new Set(state.entries.map(entry => entry.id))
    for (const id of markdownCache.current.keys()) if (!ids.has(id)) markdownCache.current.delete(id)
    const lastUser = state.entries.findLast(entry => entry.role === 'you')?.id
    return state.entries.flatMap((entry) => {
      if (entry.role === 'you') {
        return [
          ...wrapLines(entry.text, Math.max(1, width - 2)).map((text) => ({ text: `⟢ ${text}`, color: user })),
          ...(state.active && entry.id === lastUser ? [{ text: '✓ Received', color: muted }] : []),
          { text: '', color: muted }
        ]
      }
      if (entry.role === 'victral' || entry.format === 'markdown') {
        const cached = markdownCache.current.get(entry.id)
        if (cached?.text === entry.text && cached.width === width) return cached.lines
        const rendered = [
          ...markdownLines(entry.text, width).map(line => ({ ...line, color: entry.role === 'victral' ? bright : muted })),
          ...(entry.role === 'victral' ? [{ text: '[Copy Markdown]', color: codexBlue, copyId: entry.id }] : []),
          { text: '', color: muted }
        ]
        markdownCache.current.set(entry.id, { text: entry.text, width, lines: rendered })
        return rendered
      }
      return [
        ...wrapLines(entry.text, width).map((text) => ({ text, color: entry.role === 'error' ? errorRed : muted })),
        { text: '', color: muted }
      ]
    })
  }, [state.entries, state.active, panel, width, session])
  const maxScroll = Math.max(0, lines.length - bodyHeight),
    top = scroll === null ? maxScroll : Math.min(scroll, maxScroll),
    offset = maxScroll - top
  const visible = lines.slice(top, top + bodyHeight)
  const copyLabel = (line: DisplayLine) => {
    const entry = state.entries.find(entry => entry.id === line.copyId)
    return copyFeedback && copyFeedback.id === line.copyId && copyFeedback.text === entry?.text
      ? copyFeedback.label : '[Copy Markdown]'
  }
  const copyEntry = async (id: number) => {
    const entry = state.entries.find(entry => entry.id === id && entry.role === 'victral')
    if (!entry) return
    const text = entry.text
    let label: string
    try {
      const result = await copyResponse(text, stdout)
      label = result === 'copied' ? '[Copied]' : '[Copy sent]'
    } catch {
      label = '[Copy failed · retry]'
    }
    if (!mounted.current) return
    if (copyTimer.current) clearTimeout(copyTimer.current)
    setCopyFeedback({ id, text, label })
    copyTimer.current = setTimeout(() => setCopyFeedback(null), 2000)
  }
  useEffect(() => {
    setScroll((prev) => prev === null ? null : Math.min(prev, maxScroll))
  }, [maxScroll])
  const scrollBy = (amount: number) => {
    setScroll((prev) => {
      const current = prev === null ? maxScroll : Math.min(prev, maxScroll)
      const next = Math.max(0, Math.min(maxScroll, current + amount))
      return next === maxScroll ? null : next
    })
  }
  const menu = COMMANDS.slice(
    Math.max(0, selected - Math.floor(bodyHeight / 2)),
    Math.max(0, selected - Math.floor(bodyHeight / 2)) + bodyHeight
  )
  const submit = (value: string) => {
    if (!value.trim()) return
    setInput('')
    setCursor(0)
    setScroll(value.trim() === '/metrics' ? 0 : null)
    setPanel(value.trim() === '/metrics' ? 'metrics' : 'chat')
    setHistoryIndex(-1)
    setHistory((prev) => [...prev.slice(-99), value])
    void session.submit(value).catch((error) => {
      void session.close().finally(() => exit(error))
    })
  }
  useInput((key, event) => {
    const click = /^\x1b\[<0;(\d+);(\d+)M$/.exec(key)
    if (click) {
      if (panel !== 'chat' || rows < 16 || columns < 42) return
      const x = Number(click[1]), y = Number(click[2])
      const line = visible[y - headerHeight - 1]
      if (y > headerHeight && y <= headerHeight + bodyHeight && line?.copyId !== undefined && x >= 2 && x < 2 + stringWidth(copyLabel(line))) {
        void copyEntry(line.copyId)
      }
      return
    }
    if (event.ctrl && key === 'c') {
      if (state.active) session.cancel()
      else void session.close()
      return
    }
    if (event.escape) {
      if (panel !== 'chat') {
        setPanel('chat')
        setScroll(null)
      }
      else if (state.active) session.cancel()
      return
    }
    if (event.ctrl && key === 'p') {
      setPanel((prev) => (prev === 'commands' ? 'chat' : 'commands'))
      setScroll(null)
      setSelected(0)
      return
    }
    if (event.ctrl && key === 'o') {
      setPanel((prev) => (prev === 'metrics' ? 'chat' : 'metrics'))
      setScroll(panel === 'metrics' ? null : 0)
      return
    }
    if (panel !== 'commands' && (event.pageUp || (event.shift && event.upArrow))) {
      scrollBy(event.pageUp ? -bodyHeight : -3)
      return
    }
    if (panel !== 'commands' && (event.pageDown || (event.shift && event.downArrow))) {
      scrollBy(event.pageDown ? bodyHeight : 3)
      return
    }
    if (panel !== 'commands' && (event.home || event.end)) {
      setScroll(event.home && maxScroll > 0 ? 0 : null)
      return
    }
    if (panel === 'commands') {
      if (event.upArrow) setSelected((prev) => Math.max(0, prev - 1))
      if (event.downArrow) setSelected((prev) => Math.min(COMMANDS.length - 1, prev + 1))
      if (event.return) {
        const value = COMMANDS[selected]![0] + ' '
        setInput(value)
        setCursor(value.length)
        setPanel('chat')
      }
      return
    }
    if (completion.suggestions.length && (event.upArrow || event.downArrow || (event.tab && event.shift))) {
      const direction = event.upArrow || event.shift ? -1 : 1
      setCompletionSelection({ key: completion.key, index: (completionIndex + direction + completion.suggestions.length) % completion.suggestions.length })
      return
    }
    if (event.tab) {
      const completed = completeCommand(input, completion, completionIndex)
      if (completed) {
        setInput(completed.input)
        setCursor(completed.cursor)
      }
      return
    }
    if (event.upArrow || event.downArrow) {
      const index = event.upArrow ? Math.min(history.length - 1, historyIndex + 1) : Math.max(-1, historyIndex - 1)
      setHistoryIndex(index)
      const value = index < 0 ? '' : (history[history.length - 1 - index] ?? '')
      setInput(value)
      setCursor(Array.from(value).length)
      return
    }
    const chars = Array.from(input)
    if (event.return) {
      submit(input)
      return
    }
    if (event.leftArrow) {
      setCursor(Math.max(0, cursor - 1))
      return
    }
    if (event.rightArrow) {
      setCursor(Math.min(chars.length, cursor + 1))
      return
    }
    if (event.ctrl) {
      if (key === 'a') setCursor(0)
      if (key === 'e') setCursor(chars.length)
      if (key === 'u') {
        setInput(chars.slice(cursor).join(''))
        setCursor(0)
      }
      return
    }
    if (event.backspace || event.delete) {
      if (cursor > 0) {
        chars.splice(cursor - 1, 1)
        setInput(chars.join(''))
        setCursor(cursor - 1)
      }
      return
    }
    const value = safeText(key).replace(/\r/g, '\n')
    if (value) {
      chars.splice(cursor, 0, value)
      setInput(chars.join(''))
      setCursor(cursor + Array.from(value).length)
    }
  })
  const inputChars = Array.from(input.replace(/\n/g, '↵'))
  let start = cursor
  let available = Math.max(1, columns - 6)
  while (start > 0 && stringWidth(inputChars.slice(start - 1, cursor).join('')) < available - 2) start--
  const beforeCursor = inputChars.slice(start, cursor).join('')
  const afterCursor = inputChars.slice(cursor + 1).join('')
  const spinner = ['◐', '◓', '◑', '◒'][tick % 4]
  const jevStatus = state.jev ? formatJevStatus(state.jev, Math.max(12, width - 13)) : ''
  const statusRight = offset
    ? `↑ ${offset} lines`
    : panel === 'metrics'
      ? 'METRICS'
      : panel === 'commands'
        ? 'COMMANDS'
        : state.active
          ? `${spinner} ${state.phase}`
          : maxScroll > 0 && columns >= 80 ? 'PgUp/PgDn · scroll' : ''

if rows < 16 || columns < 42
  Box(flexDirection="column")
    Text(color={codexBlue}) VICTRAL · resize terminal
    Text Use at least 42 columns × 16 rows.
    Text Ctrl+C to close, or start with --plain.
else
  Box(flexDirection="column" width={columns} height={rows})
    Box(flexDirection="row" width={columns} justifyContent="space-between" paddingX={1} paddingTop={1} flexShrink={0})
      Text(wrap="truncate-end")
        Text(color={codexBlue}) #{'💲 '}
        Text(bold color={bright}) Victral
        Text(color={muted}) #{` (v${VERSION})`}
      Text(color={muted} wrap="truncate-end") #{`  ${project}`}
      Text
    Box(flexDirection="column" paddingX={1} height={bodyHeight} flexShrink={0})
      if !state.entries.length && panel === 'chat'
        Text(color={codexBlue}) A half-formed idea will do.
      if panel === 'commands'
        each item in menu key item[0]
          Text(color={COMMANDS[selected]![0] === item[0] ? codexBlue : muted} wrap="truncate-end")
            | #{(COMMANDS[selected]![0] === item[0] ? '⟢ ' : '  ') + item[0].padEnd(10) + ' ' + item[1]}
      else
        each line, index in visible key index
          Box(height={1} flexShrink={0})
            Text(color={line.color} wrap="truncate-end")
              if line.copyId !== undefined
                Text #{copyLabel(line)}
              else
                if line.spans
                  each span, spanIndex in line.spans key spanIndex
                    Text({...span}) #{span.text}
                else
                  Text #{line.text || ' '}
    if state.active
      Box(height={1} paddingX={1} flexShrink={0})
        Text(color={codexBlue} wrap="truncate-end") #{`${spinner} Working · ${safeText(state.phase)}`}
    Box(backgroundColor={composerBg} paddingX={1} paddingY={1} flexShrink={0})
      Text(wrap="truncate-end")
        Text(color={bright}) #{'⧽ '}
        if input
          fragment
            Text(color={bright}) #{beforeCursor}
            Text(inverse={panel !== 'commands'}) #{inputChars[cursor] ?? ' '}
            Text(color={bright}) #{afterCursor}
        else
          fragment
            Text(inverse={panel !== 'commands'}) #{' '}
            Text(color={composerDim}) #{state.active ? 'Steer the agent while it works…' : panel === 'commands' ? 'Type a command…' : panel === 'metrics' ? 'Metrics open · Esc to return…' : 'Ask anything about your project…'}
    Box(height={1} paddingX={1} flexShrink={0})
      if panel !== 'commands' && completion.suggestions.length
        Text(color={codexBlue} wrap="truncate-end") #{completionStatus(completion, completionIndex, width)}
      else
        fragment
          Box(flexGrow={1} flexShrink={1} minWidth={0})
            Text(wrap="truncate-end")
              Text(color={statusModel}) #{safeText(shortModelName(state.model))}
              Text(color={statusDot}) #{' · '}
              Text(color={statusPath}) #{project}
          if statusRight
            Box(marginLeft={1} flexShrink={0} minWidth={0})
              Text(color={muted} wrap="truncate-end") #{statusRight}
          if jevStatus
            Box(marginLeft={1} width={stringWidth(jevStatus)} flexShrink={0})
              Text(color={state.jev?.errors ? errorRed : muted} wrap="truncate-end") #{jevStatus}
