module /** @jsxImportSource @octanejs/ink/intrinsics */
import { Box, Text, useApp, useInput, useWindowSize } from '@octanejs/ink';
import { useEffect, useState } from 'octane/universal/native';
import { SoundLabModel } from './lab-model.js';
import { CUES } from './catalog.js';
import { safeText } from '../terminal-text.js';
props { lab }: { lab: SoundLabModel }
setup
  const [state, setState] = useState(() => lab.snapshot())
  const { columns, rows } = useWindowSize(), { exit } = useApp()
  useEffect(() => {
    const update = () => setState(lab.snapshot())
    const closed = () => exit()
    lab.on('update', update)
    lab.on('closed', closed)
    update()
    return () => { lab.off('update', update); lab.off('closed', closed) }
  }, [lab])
  useInput((key, event) => {
    if (key === 'q' || (event.ctrl && key === 'c')) { void lab.close(); return }
    if (event.upArrow || key === 'k') lab.select(-1)
    else if (event.downArrow || event.tab || key === 'j') lab.select(1)
    else if (event.leftArrow || key === '-') lab.volume(-0.05)
    else if (event.rightArrow || key === '+' || key === '=') lab.volume(0.05)
    else if (event.return || key === ' ') void lab.playSelected()
    else if (key === 'm') lab.mute()
    else if (key === 's') void lab.scenario()
    else if (key === 'f') void lab.scenario(true)
    else if (key === 'x' || event.escape) lab.stop()
  })
  const count = Math.min(CUES.length, Math.max(1, rows - 13))
  const top = Math.min(Math.max(0, state.selected - Math.floor(count / 2)), Math.max(0, CUES.length - count))
  const visible = CUES.slice(top, top + count)
  const selected = CUES[state.selected]!
  const filled = Math.round(state.volume * 10)
  const volume = `${Math.round(state.volume * 100)}% ${'━'.repeat(filled)}${'─'.repeat(10 - filled)}`
  const compact = columns < 62
if rows < 14 || columns < 36
  Box(flexDirection="column")
    Text(color="#5aa9ff") VICTRAL · SOUND LAB
    Text Resize to at least 36 columns × 14 rows.
    Text q / Ctrl+C quit · m mute · Esc stop
else
  Box(flexDirection="column" height={Math.max(rows, 10)} width={columns} paddingX={1})
    Box(height={1} flexShrink={0})
      Text(color="#5aa9ff" bold) #{'VICTRAL  /  SOUND LAB'}
    Box(height={1} flexShrink={0})
      Text(color="#8b949e" wrap="truncate-end") #{'TUI prototype · no API calls · workflow notifications are not connected'}
    Box(height={1} marginTop={1} flexShrink={0})
      Text(color={state.muted ? '#ffcb6b' : '#98c379'} wrap="truncate-end") #{`${state.muted ? 'MUTED' : 'SOUND ON'}  ·  ${volume}  ·  ${state.backend}`}
    Box(height={1} flexShrink={0})
      Text(color="#8b949e" wrap="truncate-end") #{`${top + 1}–${top + visible.length} / ${CUES.length} cues  ·  ↑↓ / j/k select  ·  Enter / Space preview`}
    each cue, index in visible key cue.sound
      Box(height={1} flexShrink={0})
        Text(color={top + index === state.selected ? '#5aa9ff' : '#e6edf3'} wrap="truncate-end")
          | #{`${top + index === state.selected ? '⟢' : ' '} ${cue.label.padEnd(18)}${compact ? cue.group : cue.description}`}
    Box(height={1} marginTop={1} flexShrink={0})
      Text(color="#ffcb6b" wrap="truncate-end") #{`${selected.label} · patch: ${selected.sound}`}
    Box(height={1} flexShrink={0})
      Text(color={state.available ? '#8b949e' : '#ff7b72'} wrap="truncate-end") #{safeText(selected.description)}
    Box(height={1} flexShrink={0})
      Text(color={state.error ? '#ff7b72' : state.active ? '#5aa9ff' : '#98c379'} wrap="truncate-end") #{safeText(state.status)}
    Box(height={1} flexShrink={0})
      Text(color="#8b949e" wrap="truncate-end") #{safeText(state.log.slice(-2).join('  →  ') || 'Nothing played yet · starts silently')}
    Box(flexGrow={1})
    Box(height={1} flexShrink={0})
      Text(color="#e6edf3" wrap="truncate-end") #{'s  recovery → success   ·   f  retry → failure'}
    Box(height={1} flexShrink={0})
      Text(color="#8b949e" wrap="truncate-end") #{'←→ volume  ·  m mute  ·  x / Esc stop  ·  q quit'}
